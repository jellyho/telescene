            def "bror_cart_caster_br" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (-0.013998912, 0, -0.029250024)
                float3 physics:diagonalInertia = (0.00007697855, 0.000054033884, 0.000045456087)
                float physics:mass = 0.15000486
                quatf physics:principalAxes = (1, 0, -0.000001941416, 0)

                def PhysicsRevoluteJoint "bror_cart_swivel_br" (
                    prepend apiSchemas = ["MjcJointAPI", "NewtonJointAPI"]
                )
                {
                    uniform double mjc:damping = 0.002
                    float newton:armature = 0.0005
                    float newton:damping = 0.000034906585
                    float newton:friction = 0.002
                    uniform token physics:axis = "Z"
                    rel physics:body0 = </palette_cell/Geometry/bror_cart>
                    rel physics:body1 = </palette_cell/Geometry/bror_cart/bror_cart_caster_br>
                    point3f physics:localPos0 = (-0.405, -0.255, 0.096)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }

                def "bror_cart_wheel_br" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
